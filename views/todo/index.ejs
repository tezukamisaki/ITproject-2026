
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TODOアプリ</title>
</head>
<body>
  <h1>TODOアプリ</h1>

  <form id="todo-form">
    <input
      type="text"
      id="todo-title"
      placeholder="TODOを入力してください"
      maxlength="100"
      required
    >
    <button type="submit">追加</button>
  </form>

  <p id="message"></p>
  <p id="empty-message">TODOがありません</p>

  <ul id="todo-list"></ul>

  <script src="/todo/todo.js"></script>
</body>
</html>
